{
	"size": 0,
	"query": {
		"bool": {
			"must": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lte": "now/d"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			]
		}
	},
	"aggs": {
		"unique_queries": {
			"terms": {
				"field": "query_statement.keyword",
				"size": 100
			},
			"aggs": {
				"query_count": {
					"value_count": {
						"field": "query_statement.keyword"
					}
				},
				"timestamps": {
					"terms": {
						"field": "@timestamp",
						"size": 100,
						"order": {
							"_key": "desc"
						}
					},
					"aggs": {
						"query_time_at_timestamp": {
							"top_hits": {
								"size": 100,
								"_source": {
									"includes": [
										"query_time"
									]
								},
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								]
							}
						}
					}
				}
			}
		}
	}
}