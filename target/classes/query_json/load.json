{
	"size": 0,
	"query": {
		"bool": {
			"filter": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lte": "now"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			]
		}
	},
	"aggs": {
		"group_by_hostname": {
			"terms": {
				"field": "ip_address.keyword",
				"size": 100
			},
			"aggs": {
				"load_metrics": {
					"filter": {
						"term": {
							"metricset.name.keyword": "load"
						}
					},
					"aggs": {
						"load_1_avg": {
							"avg": {
								"field": "system.load.1"
							}
						},
						"load_5_avg": {
							"avg": {
								"field": "system.load.5"
							}
						},
						"load_15_avg": {
							"avg": {
								"field": "system.load.15"
							}
						},
						"current_loads": {
							"top_hits": {
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								],
								"_source": {
									"includes": [
										"system.load.1",
										"system.load.5",
										"system.load.15",
										"host.os.family",
										"host.os.platform",
										"host.os.type",
										"environment",
                						"ip_address",
										"@timestamp"
									]
								},
								"size": 1
							}
						}
					}
				},
				"cpu_metrics": {
					"filter": {
						"term": {
							"metricset.name.keyword": "cpu"
						}
					},
					"aggs": {
						"current_cpu": {
							"top_hits": {
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								],
								"_source": {
									"includes": [
										"system.cpu.idle.norm.pct",
										"system.cpu.system.norm.pct",
										"system.cpu.user.norm.pct",
										"system.cpu.total.norm.pct",
										"host.os.platform",
										"system.cpu.cores",
										"environment",
                						"ip_address",
										"@timestamp"
									]
								},
								"size": 1
							}
						}
					}
				},
				"memory_metrics": {
					"filter": {
						"term": {
							"metricset.name.keyword": "memory"
						}
					},
					"aggs": {
						"current_memory": {
							"top_hits": {
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								],
								"_source": {
									"includes": [
										"system.memory.actual.used.pct",
										"system.memory.actual.used.bytes",
										"system.memory.actual.free",
										"system.memory.free",
										"system.memory.used.pct",
										"system.memory.used.bytes",
										"system.memory.total",
										"system.memory.cached",
										"environment",
                						"ip_address",
										"@timestamp"
									]
								},
								"size": 1
							}
						}
					}
				},
				"uptime_metrics": {
					"filter": {
						"term": {
							"metricset.name.keyword": "uptime"
						}
					},
					"aggs": {
						"uptime_avg": {
							"avg": {
								"field": "system.uptime.duration.ms"
							}
						},
						"current_uptime": {
							"top_hits": {
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								],
								"_source": {
									"includes": [
										"system.uptime.duration.ms",
										"host.os.family",
										"host.os.platform",
										"host.os.type",
										"environment",
                						"ip_address",
										"@timestamp"
									]
								},
								"size": 1
							}
						}
					}
				}
			}
		}
	}
}