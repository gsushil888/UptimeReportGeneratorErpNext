{
	"size": 0,
	"query": {
		"bool": {
			"filter": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lte": "now"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			]
		}
	},
	"aggs": {
		"group_by_hostname": {
			"terms": {
				"field": "ip_address.keyword",
				"size": 100
			},
			"aggs": {
				"cpu_metrics": {
					"filter": {
						"term": {
							"metricset.name.keyword": "cpu"
						}
					},
					"aggs": {
						"current_cpu": {
							"top_hits": {
								"sort": [
									{
										"@timestamp": {
											"order": "desc"
										}
									}
								],
								"_source": {
									"includes": [
										"system.cpu.idle.norm.pct",
										"system.cpu.system.norm.pct",
										"system.cpu.user.norm.pct",
										"system.cpu.total.norm.pct",
										"system.cpu.nice.norm.pct",
										"system.cpu.iowait.norm.pct",
										"system.cpu.steal.norm.pct",
										"host.os.platform",
										"system.cpu.cores",
										"environment",
										"ip_address",
										"@timestamp"
									]
								},
								"size": 1
							}
						}
					}
				}
			}
		}
	}
}