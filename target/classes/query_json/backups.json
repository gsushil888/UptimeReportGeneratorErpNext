{
	"size": 0,
	"query": {
		"bool": {
			"must": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lt": "now/d",
							"time_zone": "+05:30"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			]
		}
	},
	"aggs": {
		"per_hour": {
			"date_histogram": {
				"field": "@timestamp",
				"fixed_interval": "1h",
				"offset": "30m", 
				"min_doc_count": 0
			},
			"aggs": {
				"dr_sync": {
					"filter": {
						"term": {
							"_index": "dr_sync_index"
						}
					},
					"aggs": {
						"backup_timestamp": {
							"min": {
								"field": "@timestamp"
							}
						}
					}
				},
				"app_backup": {
					"filter": {
						"term": {
							"_index": "job_monitoring_app_index"
						}
					},
					"aggs": {
						"backup_timestamp": {
							"min": {
								"field": "@timestamp"
							}
						}
					}
				},
				"db_backup": {
					"filter": {
						"term": {
							"_index": "job_monitoring_db_index"
						}
					},
					"aggs": {
						"backup_timestamp": {
							"min": {
								"field": "@timestamp"
							}
						}
					}
				}
			}
		}
	}
}