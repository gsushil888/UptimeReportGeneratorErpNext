{
	"size": 0,
	"query": {
		"bool": {
			"filter": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lte": "now"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			]
		}
	},
	"aggs": {
		"group_by_service": {
			"terms": {
				"field": "process_name.keyword",
				"size": 100
			},
			"aggs": {
				"current_redis": {
					"top_hits": {
						"sort": [
							{
								"@timestamp": {
									"order": "desc"
								}
							}
						],
						"_source": {
							"includes": [
								"status",
								"uptime_time",
								"uptime_days",
								"uptime",
								"process_name",
								"service_name",
								"ip_address",
								"@timestamp"
							]
						},
						"size": 1
					}
				}
			}
		}
	}
}